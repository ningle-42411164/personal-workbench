{
  "name": "personal-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "build:offline": "node scripts/build.mjs offline",
    "build:all": "npm run build:cloud && npm run build:offline",
    "build:cloud": "node scripts/build.mjs cloud",
    "dev:public": "vite --mode public --host 127.0.0.1 --port 5175",
    "build:public": "node scripts/build.mjs public",
    "preview:public": "vite preview --mode public --outDir dist/public --host 127.0.0.1 --port 4175"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.44.0",
    "fractional-indexing": "3.2.0",
    "oauth4webapi": "3.8.8",
    "sortablejs": "1.15.6",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.4",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "yaml": "2.9.1"
  }
}
